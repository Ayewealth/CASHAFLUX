{
  "name": "fullstack-template",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"pnpm --filter @template/server dev\" \"pnpm --filter @template/client dev\"",
    "build": "pnpm --filter @template/client build",
    "start": "tsx apps/server/src/index.ts",
    "db:push": "pnpm --filter @template/server db:push",
    "db:studio": "pnpm --filter @template/server db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3"
  }
}
